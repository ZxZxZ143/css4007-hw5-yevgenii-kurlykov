# Copy to .env. Part 1 does not need a model or API key.
# Part 2 requires both values; choose a tool-capable model available to your account.
OPENAI_API_KEY=
MODEL_NAME=
# Part 2 saves local draft files here; conversation state remains in process only.
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
