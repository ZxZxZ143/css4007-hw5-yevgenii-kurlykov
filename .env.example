# Copy to .env. Part 1 does not need a model or API key.
# Parts 2-3 require both values; choose a tool-capable model available to your account.
OPENAI_API_KEY=
MODEL_NAME=
# Local drafts live here; persistent mode also stores SQLite checkpoints and user JSON.
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
